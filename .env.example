# Bu faylı .env.local adı ilə kopyala. Real açarları Git-ə və çata yazma.
# Aşağıdakı iki Supabase dəyişənini birlikdə doldur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Namizəd sessiyaları və praktik hesabatlar üçün yalnız server açarı.
SUPABASE_SECRET_KEY=
# Claude modeli Console-da hesabına açıq olan model adı olmalıdır.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Yalnız lokal, bir prosesli demo üçündür. Supabase varsa istifadə edilmir.
LOCAL_DEMO_MODE=true
